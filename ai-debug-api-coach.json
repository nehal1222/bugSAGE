    {
      "name": "3. Debug Help - Python",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains debugging help\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.response).to.exist;",
              "    pm.expect(jsonData.model_used).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"python\",\n  \"level\": \"beginner\",\n  \"error\": \"IndexError: list index out of range\\nmy_list = [1, 2, 3]\\nprint(my_list[5])\",\n  \"context\": \"Trying to access list elements\",\n  \"user_id\": \"{{testUserId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/debug",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "debug"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Debug Help - JavaScript",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"javascript\",\n  \"level\": \"intermediate\",\n  \"error\": \"TypeError: Cannot read property 'length' of undefined\\nlet arr = undefined;\\nconsole.log(arr.length);\",\n  \"context\": \"Working with arrays in web application\",\n  \"user_id\": \"{{testUserId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/debug",
