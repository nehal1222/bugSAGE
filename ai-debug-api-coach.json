            "{{baseUrl}}"
          ],
          "path": [
            "debug"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Generate Practice Questions",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Session ID is present\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.session_id).to.exist;",
              "    pm.environment.set(\"sessionId\", jsonData.session_id);",
              "});",
              "",
              "pm.test(\"Questions are generated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.questions).to.be.an('array');",
              "    pm.expect(jsonData.questions.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"python\",\n  \"level\": \"beginner\",\n  \"mode\": \"quiz\",\n  \"user_id\": \"{{testUserId}}\",\n  \"num_questions\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/practice/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "practice",
            "generate"
          ]
        }
      },
      "response": []
    },
    {
      "name": "6. Submit Practice Answer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Use the session ID from the previous request",
              "if (!pm.environment.get(\"sessionId\")) {",
              "    console.log(\"Warning: No session ID found. Run 'Generate Practice Questions' first.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"{{testUserId}}\",\n  \"session_id\": \"{{sessionId}}\",\n  \"question_id\": 1,\n  \"user_answer\": \"B\",\n  \"time_taken_seconds\": 45\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/practice/answer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "practice",
            "answer"
          ]
        }
      },
      "response": []
    },
